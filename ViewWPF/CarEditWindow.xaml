<Window x:Class="ViewWPF.CarEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewWPF"
        mc:Ignorable="d"
        Title="Данные автомобиля" Height="557" Width="288"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14,16,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Марка -->
        <TextBlock Grid.Row="0" Text="Марка" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Width="242" Height="27" Margin="0,0,0,16" HorizontalAlignment="Left"/>

        <!-- Модель -->
        <TextBlock Grid.Row="2" Text="Модель" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Width="242" Height="27" Margin="0,0,0,16" HorizontalAlignment="Left"/>

        <!-- Гос. номер -->
        <TextBlock Grid.Row="4" Text="Гос. номер" Margin="0,0,0,4"/>
        <TextBox Grid.Row="5" Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}" Width="242" Height="27" Margin="0,0,0,16" HorizontalAlignment="Left"/>

        <!-- Год -->
        <TextBlock Grid.Row="6" Text="Год" Margin="0,0,0,4"/>
        <TextBox Grid.Row="7" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Width="242" Height="27" Margin="0,0,0,16" HorizontalAlignment="Left"/>

        <!-- Пробег -->
        <TextBlock Grid.Row="8" Text="Пробег" Margin="0,0,0,4"/>
        <TextBox Grid.Row="9" Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged}" Width="242" Height="27" Margin="0,0,0,16" HorizontalAlignment="Left"/>

        <!-- Цена за час -->
        <TextBlock Grid.Row="10" Text="Цена за час (руб)" Margin="0,0,0,4"/>
        <TextBox Grid.Row="11" Text="{Binding RentalPricePerHour, UpdateSourceTrigger=PropertyChanged}" Width="242" Height="27" Margin="0,0,0,16" HorizontalAlignment="Left"/>

        <!-- Статус -->
        <TextBlock Grid.Row="12" Text="Статус" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="13" SelectedValue="{Binding Status, Mode=TwoWay}" SelectedValuePath="Tag" Width="242" Height="28" Margin="0,0,0,16" HorizontalAlignment="Left">
            <ComboBoxItem Content="Свободен" Tag="0"/>
            <ComboBoxItem Content="В аренде" Tag="1"/>
            <ComboBoxItem Content="На тех. обслуживании" Tag="2"/>
        </ComboBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="15" Orientation="Horizontal" Margin="0,8,0,16">
            <Button Content="ОК" Command="{Binding SaveCommand}" Width="117" Height="36" Margin="0,0,8,0" Click="ButtonOK_Click"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="117" Height="36" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
