<Window x:Class="ViewWPF.CalculateCostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewWPF"
        mc:Ignorable="d"
        Title="Расчет стоимости аренды" Height="370" Width="403"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14,16,14,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Car Info -->
        <TextBlock Grid.Row="0" Text="{Binding CarInfo}" FontSize="14" FontWeight="Bold"
                   TextAlignment="Center" Margin="0,0,0,16"/>

        <!-- Price Per Hour -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock Text="Цена за час:" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PricePerHour, StringFormat={}{0:F2} руб.}" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="7,0,0,0"/>
        </StackPanel>

        <!-- Hours -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock Text="Количество часов:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}" Width="137" Height="27"
                     VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Total Cost Caption -->
        <TextBlock Grid.Row="3" Text="Итого к оплате:" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Total Cost -->
        <TextBlock Grid.Row="4" Text="{Binding TotalCost, StringFormat={}{0:F2} руб.}" FontSize="16" FontWeight="Bold"
                   TextAlignment="Center" Margin="0,0,0,16"/>

        <!-- Promo Code -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Text="{Binding PromoCode, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="27"
                     VerticalAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Введите промокод" Foreground="Gray" Margin="2,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <Button Content="Применить промокод" Command="{Binding ApplyPromoCommand}" Width="152" Height="34"
                    VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Discount Info -->
        <TextBlock Grid.Row="6" Text="{Binding DiscountInfo}" Foreground="Green" Margin="0,0,0,8"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <Button Content="ОК" Command="{Binding CloseCommand}" Width="117" Height="36" Click="ButtonOK_Click"/>
            <Button Content="Детализация 📊" Click="ButtonShowDetails_Click" Width="234" Height="36" Margin="7,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
