<Window x:Class="ViewWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewWPF"
        mc:Ignorable="d"
        Title="UrbanGo" Height="708" Width="1280" MinWidth="1280" MinHeight="708"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Стиль для кнопок, которые остаются видимыми даже в disabled состоянии -->
        <Style x:Key="AlwaysVisibleButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Controls Panel -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F4F6F9" Height="54">
            <Button Content="Добавить ➕" Command="{Binding AddNewCommand}"
                    Width="111" Height="40" Margin="12,6,0,0"
                    Background="#0078D7" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
            <Button Content="Изменить ✏️" Command="{Binding EditCommand}"
                    Style="{StaticResource AlwaysVisibleButtonStyle}"
                    Width="110" Height="40" Margin="6,6,0,0"
                    Background="#0078D7" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
            <Button Content="Удалить 🗑️" Command="{Binding DeleteCommand}"
                    Style="{StaticResource AlwaysVisibleButtonStyle}"
                    Width="130" Height="40" Margin="5,6,0,0"
                    Background="#0078D7" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
            <Button Content="Арендовать 🔑" Command="{Binding RentCarCommand}"
                    Style="{StaticResource AlwaysVisibleButtonStyle}"
                    Width="135" Height="40" Margin="6,6,0,0"
                    Background="#0078D7" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
            <Button Content="Рассчитать 🧮" Command="{Binding CalculateCostCommand}"
                    Style="{StaticResource AlwaysVisibleButtonStyle}"
                    Width="131" Height="40" Margin="6,6,0,0"
                    Background="#0078D7" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
            <Button Content="Обновить 🔄" Command="{Binding LoadDataCommand}"
                    Width="113" Height="40" Margin="6,6,0,0"
                    Background="#0078D7" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
            <Button Content="Импорт 📥" Command="{Binding ImportCommand}"
                    Width="127" Height="40" Margin="6,6,0,0"
                    Background="#228B22" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
            <Button Content="Экспорт 📤" Click="ButtonExport_Click"
                    Width="127" Height="40" Margin="6,6,0,0"
                    Background="#228B22" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
            <Button Content="QR-код 📱" Click="ButtonQRCode_Click"
                    Style="{StaticResource AlwaysVisibleButtonStyle}"
                    Width="127" Height="40" Margin="6,6,0,0"
                    Background="#FF9800" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
        </StackPanel>

        <!-- Search Panel -->
        <Grid Grid.Row="1" Background="#F4F6F9" Height="54">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Поиск по марке или гос. номеру:" VerticalAlignment="Center" Margin="11,0,0,0"/>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="130" Height="27" Margin="13,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="💵 Стандартное ценообразование"
                       VerticalAlignment="Center" Margin="26,0,0,0"
                       Foreground="DarkGreen" FontWeight="Bold"/>
            <Button Grid.Column="4" Content="Поиск 🔍" Command="{Binding SearchCommand}"
                    Width="125" Height="34" Margin="0,0,14,0" VerticalAlignment="Center"
                    Background="#0078D7" Foreground="White"
                    FontFamily="Impact" FontSize="10.5" BorderThickness="0"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" x:Name="dataGridCars"
                  ItemsSource="{Binding Cars}"
                  SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  Margin="14,10,14,10"
                  AlternationCount="2"
                  AlternatingRowBackground="LightGray">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Гос. номер" Binding="{Binding LicensePlate}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Пробег" Binding="{Binding Mileage}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Цена/час" Binding="{Binding RentalPricePerHour, StringFormat='{}{0:N2} ₽'}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
