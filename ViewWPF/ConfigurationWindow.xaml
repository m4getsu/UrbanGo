<Window x:Class="ViewWPF.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка приложения - UrbanGo" Height="350" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Конфигурация приложения" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Data Provider -->
        <TextBlock Grid.Row="1" Text="Выберите провайдер данных:" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <RadioButton x:Name="radioEF" Content="Entity Framework Core" IsChecked="True" Margin="0,0,0,8" GroupName="DataProvider"/>
            <RadioButton x:Name="radioDapper" Content="Dapper" GroupName="DataProvider"/>
        </StackPanel>

        <!-- Pricing Strategy -->
        <TextBlock Grid.Row="3" Text="Выберите стратегию ценообразования:" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <RadioButton x:Name="radioStandard" Content="Стандартная (цена × часы)" Margin="0,0,0,8" GroupName="Pricing"/>
            <RadioButton x:Name="radioDynamic" Content="Динамическая (время суток, день недели, сезон, праздники)" IsChecked="True" GroupName="Pricing"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="100" Height="30" Margin="0,0,10,0" Click="ButtonOK_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="100" Height="30" Click="ButtonCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
